# Пусто: Vite проксирует /api на http://127.0.0.1:8000.
# Прямые запросы к бэкенду с CORS: VITE_API_URL=http://127.0.0.1:8000
# Для сборки укажите публичный адрес API.
VITE_API_URL=
VITE_USE_MOCK=true
# VK Карты (MMR GL JS): https://dev.vk.com/ru/vkmaps
VITE_VK_MAPS_KEY=
# Устаревший алиас, если задан — используется при пустом VITE_VK_MAPS_KEY
VITE_VK_MAPS_ACCESS_TOKEN=
